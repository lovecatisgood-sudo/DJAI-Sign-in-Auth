NODE_ENV=development
PORT=3000
OIDC_ISSUER=http://localhost:3000
DATABASE_URL=postgres://djai_identity:change-me@localhost:5432/djai_identity
DATABASE_SSL=disable
# Optional override for the bundled Supabase root CA. Paste PEM directly or encode newlines as \n.
# DATABASE_CA_CERT=-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
SUPABASE_SECRET_KEY=replace-with-server-secret-key
OIDC_COOKIE_KEYS=replace-with-32-plus-character-key-one,replace-with-32-plus-character-key-two
AUTH_TRANSACTION_KEY=replace-with-base64-encoded-32-byte-key
CLIENT_SECRET_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key
OIDC_JWKS={"keys":[{"kty":"RSA","kid":"replace-with-generated-private-jwk"}]}
TRUST_PROXY=true
LOG_LEVEL=info
ENABLE_SIGNUP=true
DEVELOPER_CONSOLE_ENABLED=false
DEVELOPER_EMAIL_ALLOWLIST=developer@djai.academy
ACCESS_TOKEN_TTL_SECONDS=300
ID_TOKEN_TTL_SECONDS=300
AUTH_CODE_TTL_SECONDS=90
INTERACTION_TTL_SECONDS=600
SESSION_TTL_SECONDS=3600
